generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum DiscountType {
  PERCENT
  FIXED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  COD
  PAYMONGO
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum CoinType {
  EARNED
  SPENT
  EXPIRED
  REFUNDED
}

enum ShopStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum CommissionStatus {
  PENDING
  AVAILABLE
  PAID
  REVERSED
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  PAID
  REJECTED
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DeliveryStatus {
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum ReturnRequestType {
  REFUND_ONLY
  RETURN_AND_REFUND
}

enum ReturnRequestReason {
  ITEM_NOT_RECEIVED
  ITEM_DEFECTIVE
  WRONG_ITEM_SENT
  MISSING_PARTS
  NOT_AS_DESCRIBED
  CHANGED_MIND
  OTHER
}

enum ReturnRequestStatus {
  PENDING_SELLER
  SELLER_APPROVED
  SELLER_REJECTED
  ADMIN_REVIEW
  ADMIN_APPROVED
  ADMIN_REJECTED
  CANCELLED
  COMPLETED
}

enum OrderEventType {
  ORDER_PLACED
  PAYMENT_RECEIVED
  ORDER_SHIPPED
  DELIVERY_STATUS_UPDATED
  ORDER_DELIVERED
  ORDER_CANCELLED
  RETURN_REQUESTED
  RETURN_SELLER_APPROVED
  RETURN_SELLER_REJECTED
  RETURN_ESCALATED_TO_ADMIN
  RETURN_ADMIN_APPROVED
  RETURN_ADMIN_REJECTED
  RETURN_CANCELLED_BY_BUYER
  REFUND_ISSUED
  ORDER_STATUS_CHANGED_BY_ADMIN
}

enum StockMovementType {
  SALE
  CANCELLATION_RESTOCK
  REFUND_RESTOCK
  MANUAL_ADJUSTMENT
  RESTOCK_IN
  RESERVATION_EXPIRED_RESTOCK
}

enum ReservationStatus {
  HELD
  COMMITTED
  RELEASED
  EXPIRED
}

// ─── Phase 1 Models (seeded) ─────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  clerkId      String   @unique
  name         String
  email        String   @unique
  passwordHash String?
  role         Role     @default(BUYER)
  isBanned     Boolean  @default(false)
  avatar       String?
  coins        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shop                        Shop?
  orders                      Order[]
  cart                        Cart?
  addresses                   Address[]
  reviews                     Review[]
  reviewVotes                 ReviewVote[]
  wishlist                    Wishlist[]
  notifications               Notification[]
  notificationPreferences     NotificationPreference[]
  sentMessages                Message[]                @relation("SentMessages")
  receivedMessages            Message[]                @relation("ReceivedMessages")
  searchHistory               SearchHistory[]
  coinLogs                    Coin[]
  shopFollows                 ShopFollow[]
  buyerConversations          Conversation[]           @relation("BuyerConversations")
  refundsInitiated            Refund[]
  auditLogs                   AuditLog[]
  staffMemberships            ShopStaff[]              @relation("StaffMemberships")
  staffInvitesSent            ShopStaff[]              @relation("StaffInvitesSent")
  returnRequestsFiled         ReturnRequest[]          @relation("ReturnRequestsFiled")
  returnRequestsSellerDecided ReturnRequest[]          @relation("ReturnRequestsSellerDecided")
  returnRequestsAdminDecided  ReturnRequest[]          @relation("ReturnRequestsAdminDecided")
  timelineEventsActed         OrderTimelineEvent[]
  stockMovementsActed         StockMovement[]
  analyticsEvents             AnalyticsEvent[]
}

model Shop {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  logo            String?
  banner          String?
  rating          Float      @default(0)
  followersCount  Int        @default(0)
  ownerId         String     @unique
  createdAt       DateTime   @default(now())
  status          ShopStatus @default(PENDING)
  rejectionReason String?
  commissionRate  Float      @default(10)
  isOnVacation    Boolean    @default(false)
  vacationMessage String?

  owner             User                 @relation(fields: [ownerId], references: [id])
  products          Product[]
  vouchers          Voucher[]
  orders            Order[]
  reviewReplies     ReviewReply[]
  conversations     Conversation[]
  followers         ShopFollow[]
  commissionEntries CommissionEntry[]
  payouts           Payout[]
  staff             ShopStaff[]
  shippingMethods   ShopShippingMethod[]
  returnRequests    ReturnRequest[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
  analyticsEvents   AnalyticsEvent[]
}

enum StaffPermission {
  PRODUCTS
  ORDERS
  REVIEWS
  CHAT
  INVENTORY
  VOUCHERS
  REPORTS
}

model ShopStaff {
  id          String            @id @default(cuid())
  shopId      String
  userId      String
  permissions StaffPermission[]
  invitedById String
  createdAt   DateTime          @default(now())

  shop      Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User @relation("StaffMemberships", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User @relation("StaffInvitesSent", fields: [invitedById], references: [id])

  @@unique([shopId, userId])
  @@index([userId])
}

model Category {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  icon         String?
  imageUrl     String?
  parentId     String?
  displayOrder Int     @default(0)

  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children Category[] @relation("SubCategories")
  products Product[]
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  description     String
  price           Float
  originalPrice   Float?
  stock           Int           @default(0)
  sold            Int           @default(0)
  images          String[]
  rating          Float         @default(0)
  reviewCount     Int           @default(0)
  isTrending      Boolean       @default(false)
  isActive        Boolean       @default(true)
  status          ProductStatus @default(PENDING)
  rejectionReason String?
  categoryId      String
  brandId         String?
  shopId          String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  variantOptions  Json?

  category          Category           @relation(fields: [categoryId], references: [id])
  brand             Brand?             @relation(fields: [brandId], references: [id])
  shop              Shop               @relation(fields: [shopId], references: [id])
  variants          ProductVariant[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  reviews           Review[]
  wishlist          Wishlist[]
  flashSaleItems    FlashSaleItem[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
  analyticsEvents   AnalyticsEvent[]

  @@index([status, isActive, categoryId])
  @@index([status, isActive, shopId])
  @@index([status, isActive, sold])
  @@index([status, isActive, createdAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_name_trgm_idx")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  name      String
  price     Float
  stock     Int
  sku       String?
  image     String?

  product           Product            @relation(fields: [productId], references: [id])
  cartItems         CartItem[]
  orderItems        OrderItem[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
}

model Banner {
  id           String   @id @default(cuid())
  imageUrl     String
  linkUrl      String?
  title        String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model Voucher {
  id            String       @id @default(cuid())
  code          String       @unique
  title         String
  discountType  DiscountType
  discountValue Float
  minSpend      Float        @default(0)
  maxDiscount   Float?
  expiresAt     DateTime
  isActive      Boolean      @default(true)
  usageLimit    Int?
  createdAt     DateTime     @default(now())
  shopId        String?

  shop   Shop?   @relation(fields: [shopId], references: [id])
  orders Order[]

  @@index([shopId])
}

// ─── Phase 2–3 Models ────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int

  cart    Cart            @relation(fields: [cartId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
}

model Order {
  id                 String      @id @default(cuid())
  userId             String
  shopId             String
  status             OrderStatus @default(PENDING)
  total              Float
  shippingFee        Float       @default(0)
  discountAmount     Float       @default(0)
  coinsUsed          Int         @default(0)
  coinDiscount       Float       @default(0)
  paymentMethod      String?
  addressId          String
  voucherId          String?
  shippingMethodId   String?
  shippingMethodName String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user              User                 @relation(fields: [userId], references: [id])
  shop              Shop                 @relation(fields: [shopId], references: [id])
  address           Address              @relation(fields: [addressId], references: [id])
  voucher           Voucher?             @relation(fields: [voucherId], references: [id])
  shippingMethod    ShippingMethod?      @relation(fields: [shippingMethodId], references: [id])
  items             OrderItem[]
  payment           Payment?
  shipment          Shipment?
  refund            Refund?
  commissionEntry   CommissionEntry?
  returnRequest     ReturnRequest?
  timelineEvents    OrderTimelineEvent[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
  analyticsEvents   AnalyticsEvent[]
  coinLogs          Coin[]

  @@index([userId])
  @@index([shopId, status])
  @@index([status, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  quantity  Int
  price     Float

  order   Order           @relation(fields: [orderId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  fullName   String
  phone      String
  street     String
  barangay   String  @default("")
  city       String
  province   String
  postalCode String
  isDefault  Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id])
  orders Order[]
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String          @unique
  method            String
  provider          PaymentProvider @default(COD)
  status            PaymentStatus   @default(PENDING)
  amount            Float
  reference         String?
  checkoutSessionId String?
  externalPaymentId String?
  metadata          Json?
  paidAt            DateTime?

  order  Order   @relation(fields: [orderId], references: [id])
  refund Refund?

  @@index([checkoutSessionId])
}

model Refund {
  id                String       @id @default(cuid())
  paymentId         String       @unique
  orderId           String       @unique
  amount            Float
  status            RefundStatus @default(PENDING)
  reason            String?
  initiatedByUserId String
  gatewayRefundId   String?
  createdAt         DateTime     @default(now())
  processedAt       DateTime?

  payment       Payment        @relation(fields: [paymentId], references: [id])
  order         Order          @relation(fields: [orderId], references: [id])
  initiatedBy   User           @relation(fields: [initiatedByUserId], references: [id])
  returnRequest ReturnRequest?
}

model ReturnRequest {
  id      String @id @default(cuid())
  orderId String @unique
  buyerId String
  shopId  String

  type         ReturnRequestType
  reason       ReturnRequestReason
  description  String
  evidenceUrls String[]            @default([])

  status ReturnRequestStatus @default(PENDING_SELLER)

  sellerReviewDeadline  DateTime
  sellerDecisionNote    String?
  sellerDecidedAt       DateTime?
  sellerDecidedByUserId String?

  adminDecisionNote    String?
  adminDecidedAt       DateTime?
  adminDecidedByUserId String?

  refundId   String?   @unique
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order           Order   @relation(fields: [orderId], references: [id])
  buyer           User    @relation("ReturnRequestsFiled", fields: [buyerId], references: [id])
  shop            Shop    @relation(fields: [shopId], references: [id])
  sellerDecidedBy User?   @relation("ReturnRequestsSellerDecided", fields: [sellerDecidedByUserId], references: [id])
  adminDecidedBy  User?   @relation("ReturnRequestsAdminDecided", fields: [adminDecidedByUserId], references: [id])
  refund          Refund? @relation(fields: [refundId], references: [id])

  @@index([shopId, status])
  @@index([status, sellerReviewDeadline])
}

model OrderTimelineEvent {
  id        String         @id @default(cuid())
  orderId   String
  type      OrderEventType
  message   String
  actorId   String?
  actorRole Role?
  metadata  Json?
  createdAt DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id])
  actor User? @relation(fields: [actorId], references: [id])

  @@index([orderId, createdAt])
}

model CommissionEntry {
  id               String           @id @default(cuid())
  orderId          String           @unique
  shopId           String
  orderTotal       Float
  commissionRate   Float
  commissionAmount Float
  netAmount        Float
  status           CommissionStatus @default(PENDING)
  eligibleAt       DateTime
  payoutId         String?
  createdAt        DateTime         @default(now())

  order  Order   @relation(fields: [orderId], references: [id])
  shop   Shop    @relation(fields: [shopId], references: [id])
  payout Payout? @relation(fields: [payoutId], references: [id])

  @@index([shopId, status])
}

model Payout {
  id                String       @id @default(cuid())
  shopId            String
  amount            Float
  status            PayoutStatus @default(REQUESTED)
  requestedAt       DateTime     @default(now())
  processedByUserId String?
  processedAt       DateTime?
  referenceNote     String?
  createdAt         DateTime     @default(now())

  shop    Shop              @relation(fields: [shopId], references: [id])
  entries CommissionEntry[]

  @@index([shopId, status])
}

model Shipment {
  id                String         @id @default(cuid())
  orderId           String         @unique
  courier           String?
  trackingNumber    String?
  status            DeliveryStatus @default(PACKED)
  estimatedDelivery DateTime?

  order Order @relation(fields: [orderId], references: [id])
}

model ShippingMethod {
  id          String   @id @default(cuid())
  name        String
  carrier     String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  rates     ShippingRate[]
  shopLinks ShopShippingMethod[]
  orders    Order[]
}

model ShippingZone {
  id        String   @id @default(cuid())
  name      String   @unique
  provinces String[]

  rates ShippingRate[]
}

model ShippingRate {
  id               String @id @default(cuid())
  methodId         String
  zoneId           String
  price            Float
  estimatedDaysMin Int
  estimatedDaysMax Int

  method ShippingMethod @relation(fields: [methodId], references: [id])
  zone   ShippingZone   @relation(fields: [zoneId], references: [id])

  @@unique([methodId, zoneId])
}

model ShopShippingMethod {
  id        String  @id @default(cuid())
  shopId    String
  methodId  String
  isEnabled Boolean @default(true)

  shop   Shop           @relation(fields: [shopId], references: [id])
  method ShippingMethod @relation(fields: [methodId], references: [id])

  @@unique([shopId, methodId])
}

// ─── Phase 4+ Models ─────────────────────────────────────────────────────────

model Review {
  id           String   @id @default(cuid())
  userId       String
  productId    String
  orderId      String?
  rating       Int
  comment      String?
  images       String[]
  videos       String[] @default([])
  helpfulCount Int      @default(0)
  createdAt    DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id])
  product Product      @relation(fields: [productId], references: [id])
  reply   ReviewReply?
  votes   ReviewVote[]

  @@index([productId])
  @@index([userId])
}

model ReviewVote {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  review Review @relation(fields: [reviewId], references: [id])

  @@unique([userId, reviewId])
}

model ReviewReply {
  id       String @id @default(cuid())
  reviewId String @unique
  shopId   String
  comment  String

  review Review @relation(fields: [reviewId], references: [id])
  shop   Shop   @relation(fields: [shopId], references: [id])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model FlashSale {
  id       String   @id @default(cuid())
  title    String
  startsAt DateTime
  endsAt   DateTime
  isActive Boolean  @default(true)

  items FlashSaleItem[]
}

model FlashSaleItem {
  id          String @id @default(cuid())
  flashSaleId String
  productId   String
  salePrice   Float
  stock       Int

  flashSale FlashSale @relation(fields: [flashSaleId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model NotificationPreference {
  id      String  @id @default(cuid())
  userId  String
  type    String
  enabled Boolean @default(true)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type])
}

model Message {
  id             String   @id @default(cuid())
  senderId       String
  receiverId     String
  conversationId String
  content        String
  imageUrl       String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  sender       User         @relation("SentMessages", fields: [senderId], references: [id])
  receiver     User         @relation("ReceivedMessages", fields: [receiverId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([receiverId, isRead])
}

model Conversation {
  id            String   @id @default(cuid())
  buyerId       String
  shopId        String
  lastMessageAt DateTime @default(now())

  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  shop     Shop      @relation(fields: [shopId], references: [id])
  messages Message[]

  @@unique([buyerId, shopId])
  @@index([shopId])
}

model ShopFollow {
  id        String   @id @default(cuid())
  userId    String
  shopId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  shop Shop @relation(fields: [shopId], references: [id])

  @@unique([userId, shopId])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([query, createdAt])
}

model Coin {
  id          String    @id @default(cuid())
  userId      String
  amount      Int
  type        CoinType
  description String?
  orderId     String?
  expiresAt   DateTime?
  remaining   Int       @default(0)
  createdAt   DateTime  @default(now())

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, expiresAt])
  @@index([orderId, type])
}

model StockMovement {
  id             String            @id @default(cuid())
  productId      String
  variantId      String?
  shopId         String
  type           StockMovementType
  delta          Int
  quantityBefore Int
  quantityAfter  Int
  reason         String?
  orderId        String?
  actorId        String?
  actorRole      Role?
  metadata       Json?
  createdAt      DateTime          @default(now())

  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  shop    Shop            @relation(fields: [shopId], references: [id])
  order   Order?          @relation(fields: [orderId], references: [id])
  actor   User?           @relation(fields: [actorId], references: [id])

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([shopId, createdAt])
  @@index([orderId])
}

model StockReservation {
  id        String            @id @default(cuid())
  productId String
  variantId String?
  shopId    String
  orderId   String
  quantity  Int
  status    ReservationStatus @default(HELD)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  shop    Shop            @relation(fields: [shopId], references: [id])
  order   Order           @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status, expiresAt])
  @@index([productId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

enum AnalyticsEventType {
  PRODUCT_VIEW
  ADD_TO_CART
  PURCHASE
}

model AnalyticsEvent {
  id        String             @id @default(cuid())
  type      AnalyticsEventType
  productId String?
  shopId    String?
  userId    String?
  sessionId String?
  orderId   String?
  quantity  Int?
  createdAt DateTime           @default(now())

  product Product? @relation(fields: [productId], references: [id])
  shop    Shop?    @relation(fields: [shopId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])
  order   Order?   @relation(fields: [orderId], references: [id])

  @@index([type, createdAt])
  @@index([productId, type, createdAt])
  @@index([shopId, type, createdAt])
  @@index([sessionId, type])
}
